   "source": [
    "%matplotlib inline\n",
    "\n",
    "uinf = 2.2\n",
    "du = 0.11\n",
    "r0 = 0.5\n",
    "D = r0*2\n",
    "\n",
    "r = np.linspace(-10,10,1000)\n",
    "u = uinf - du * np.exp(-0.5*(r/r0)**2)\n",
    "\n",
    "nu = du*D/50000\n",
    "Re = du*D/nu\n",
    "print(Re)\n",
    "\n",
    "plt.plot(r,u)\n",
    "plt.plot([-r0,r0],[uinf-du/2,uinf-du/2])"
   ]
  },
